	<CheckButton name="RoCUICheckboxTemplate" parentKey="CheckButton" inherits="RoCUICheckboxBaseTemplate" virtual="true">
		<Size x="24" y="24"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentText" parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" relativePoint="RIGHT" x="0" y="2"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</CheckButton>

	<CheckButton name="RoCUICheckboxBaseTemplate" motionScriptsWhileDisabled="true" virtual="true">
		<Size x="32" y="32"/>
		<Scripts>
			<OnClick>
				local checked = self:GetChecked();
				if ( self.func ) then
					self.func(self, checked);
				end

				ChatConfigFrame_PlayCheckboxSound(checked);
			</OnClick>
			<OnEnter>
				if (self.tooltip) then
					GameTooltip:SetOwner(self, "ANCHOR_RIGHT");
					GameTooltip:SetText(self.tooltip, nil, nil, nil, nil, (self.tooltipStyle or true));
				end

				if self.onEnterCallback then
					self.onEnterCallback();
				end
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide();

				if self.onLeaveCallback then
					self.onLeaveCallback();
				end
			</OnLeave>
		</Scripts>
		<NormalTexture file="Interface\AddOns\RoCUI\images\optionsmenu\checkbox"/>
		<PushedTexture file="Interface\AddOns\RoCUI\images\optionsmenu\checkbox_highlight"/>
		<HighlightTexture file="Interface\AddOns\RoCUI\images\optionsmenu\checkbox_highlight" alphaMode="ADD"/>
		<CheckedTexture file="Interface\AddOns\RoCUI\images\optionsmenu\checkmark"/>
		<DisabledCheckedTexture file="Interface\AddOns\RoCUI\images\optionsmenu\checkmark_disabled"/>
	</CheckButton>

	<Slider name="RoCUISliderTemplate" orientation="HORIZONTAL" enableMouse="true" virtual="true">
